# Copie para .env (cp .env.example .env) e troque os valores. O .env NÃO vai para o Git.

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
# IP público da EC2 (ou * apenas para teste), separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,<IP_PUBLICO_EC2>
CSRF_TRUSTED_ORIGINS=http://<IP_PUBLICO_EC2>:8000

# PostgreSQL (container db)
POSTGRES_DB=lavoura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Superusuário do Django Admin, criado no primeiro deploy
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# 1 = carrega dados de exemplo (seed) ao subir
SEED=1

# Integrações AWS: usar função IAM da EC2, sem chaves de acesso neste arquivo.
AWS_DEFAULT_REGION=us-east-2
RAIZES_S3_BUCKET=
RAIZES_DYNAMODB_TABLE=
RAIZES_SNS_TOPIC_ARN=
